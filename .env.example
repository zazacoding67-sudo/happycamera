# --- Database ---
# Supabase PostgreSQL connection string (PrismaPg adapter)
DATABASE_URL=

# --- Auth (NextAuth v4) ---
# Base URL of the deployed app. On Vercel this is https://<project>.vercel.app
NEXTAUTH_URL=
# Secret used to encrypt JWT tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Google OAuth ---
# From Google Cloud Console > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CHIP Payment Gateway (https://www.chip-in.asia) ---
# Sandbox: https://gate.chip-in.asia/api/v1
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
# RSA public key used to verify webhook X-Signature header (PEM block)
CHIP_WEBHOOK_PUBLIC_KEY=

# --- Supabase Storage ---
# Project URL and anon key from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Site config ---
# Public base URL used to build checkout redirects / payment callbacks / email links.
# On Vercel set this to the deployed URL (same as NEXTAUTH_URL). Must be reachable on
# ports 80/443 only (CHIP rejects callback URLs with custom ports).
NEXT_PUBLIC_BASE_URL=
# WhatsApp number used in the checkout-failed page contact link (format: 60123456789)
NEXT_PUBLIC_WHATSAPP_NUMBER=
